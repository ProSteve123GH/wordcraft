<?xml version="1.0" encoding="utf-8"?>
<!--
  The Activity theme.

  No fullscreen and no translucent system bars: the status bar and the navigation/gesture bar stay
  visible. The surface winit receives is the whole window, including their area, so `android_main`'s
  shell reads the Activity's content rectangle and lays the interface out only inside it. The target
  stays on SDK 34 so the bars keep classic behaviour and their configured colours. See
  docs/ANDROID_PORT_PLAN.md §3.

  `NativeActivity` sets `SOFT_INPUT_ADJUST_RESIZE` itself when it creates the window, so the surface
  (and therefore the work area) shrinks instead of the keyboard covering the document.
-->
<resources>
    <style name="WordcraftTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF3F3F3</item>
        <item name="android:statusBarColor">#FFF3F3F3</item>
        <item name="android:navigationBarColor">#FFF3F3F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
</resources>
